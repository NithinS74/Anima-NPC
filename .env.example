# Select public profile via --config configs/providers/openrouter.yaml or gemini.yaml.
# Fill the matching key locally; do not put secrets in the YAML profiles.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NPC_LLM_MODEL=
# Optional generic overrides (useful for another compatible API/local runtime):
NPC_LLM_BASE_URL=
NPC_LLM_API_KEY=
NPC_LLM_RESPONSE_FORMAT=json_object
# Future persistent/game runtime settings; preview currently uses CLI timing options.
NPC_KB_PATH=Knowledge base/kb
NPC_DATA_PATH=data
NPC_LOG_LEVEL=INFO
NPC_TEXT_DEADLINE_MS=3000
NPC_MODEL_CUTOFF_MS=2450
NPC_MAX_GENERATION_CONCURRENCY=1
NPC_MAX_PENDING_TURNS=2
NPC_MAX_ACTIVE_SESSIONS=16
NPC_EMBEDDING_DEVICE=cpu
